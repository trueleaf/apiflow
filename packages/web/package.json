{
  "name": "apiflow",
  "description": "ApiFlow is a visual API design tool that allows users to create, manage, and visualize APIs in a graphical way.",
  "author": "TrueLeaf Team",
  "license": "MIT",
  "homepage": "https://github.com/trueleaf/apiflow",
  "private": true,
  "version": "0.9.51",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "web": "cross-env BUILD_TARGET=web vite --host",
    "share": "vite --host --config build/share/vite.config.ts",
    "build:share": "vite build --config build/share/vite.config.ts && node scripts/move-share-html.mjs",
    "build:web": "cross-env BUILD_TARGET=web vite build",
    "preview": "vite preview",
    "build:font": "node build/share/script/build-font.mjs",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "build:ci:pack": "node scripts/tauri.mjs build --no-bundle",
    "build:ci": "node scripts/tauri.mjs build",
    "build:ci:win": "node scripts/tauri.mjs build",
    "build:ci:mac": "node scripts/tauri.mjs build",
    "build:ci:linux": "node scripts/tauri.mjs build",
    "build:clean": "node scripts/build-clean.mjs",
    "build:clean:pack": "node scripts/build-clean.mjs pack",
    "build:clean:win": "node scripts/build-clean.mjs win",
    "build:clean:mac": "node scripts/build-clean.mjs mac",
    "build:clean:linux": "node scripts/build-clean.mjs linux",
    "build:local:pack": "node scripts/tauri.mjs build --no-bundle",
    "build:local:win": "node scripts/tauri.mjs build",
    "build:local:win:store": "node scripts/build-store.mjs",
    "build:ci:win:store": "node scripts/build-store.mjs",
    "build:local:mac": "node scripts/tauri.mjs build",
    "build:local:linux": "node scripts/tauri.mjs build",
    "test": "npm run test:e2e",
    "test2": "npm run test:e2e:ui",
    "pretest:e2e": "node scripts/tauri.mjs build --debug --no-bundle --config src-tauri/tauri.test.conf.json",
    "pretest:e2e:web": "cross-env BUILD_TARGET=web vite build --outDir dist/web-test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:trace:show": "playwright show-trace",
    "test:e2e:build": "npm run pretest:e2e",
    "release:test": "node scripts/serve-update.mjs",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "dev:renderer:tauri": "cross-env BUILD_TARGET=tauri vite --host",
    "build:renderer:tauri": "cross-env BUILD_TARGET=tauri vite build",
    "test:native": "node scripts/cargo.mjs test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "2.0.62",
    "@ai-sdk/openai-compatible": "2.0.74",
    "@faker-js/faker": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/api": "^2.11.1",
    "ai": "6.0.273",
    "dayjs": "^1.11.12",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "file-type": "^19.6.0",
    "js-sha256": "^0.11.1",
    "js-yaml": "^4.1.1",
    "json-stable-stringify": "^1.2.1",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "mime": "^4.0.6",
    "mockjs": "^1.1.0",
    "nanoid": "^5.0.7",
    "set-cookie-parser": "^2.7.1",
    "zod": "4.5.4"
  },
