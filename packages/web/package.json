    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2.11.5",
    "@tiptap/core": "^3.3.0",
    "@tiptap/extension-history": "^3.3.0",
    "@tiptap/extension-link": "^3.11.0",
    "@tiptap/extension-placeholder": "^3.10.7",
    "@tiptap/extension-task-item": "^3.11.0",
    "@tiptap/extension-task-list": "^3.11.0",
    "@tiptap/starter-kit": "^3.3.0",
    "@tiptap/vue-3": "^3.3.0",
    "@types/js-beautify": "^1.14.3",
    "@types/js-cookie": "^3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/json-bigint": "^1.0.4",
    "@types/jsontoxml": "^1.0.6",
    "@types/lodash": "^4.17.7",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^24.6.2",
    "@types/nprogress": "^0.2.3",
    "@types/prismjs": "^1.26.5",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/tsconfig": "^0.7.0",
    "axios": "^1.7.3",
    "cross-env": "^10.1.0",
    "dexie": "^4.0.8",
    "element-plus": "^2.11.1",
    "eslint": "^9.8.0",
    "fast-glob": "^3.3.3",
    "franc-min": "^6.2.0",
    "hotkeys-js": "^4.0.0-beta.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.1",
    "js-beautify": "^1.15.1",
    "js-cookie": "^3.0.5",
    "json-bigint": "^1.0.0",
    "jsontoxml": "^1.0.1",
    "koa-body": "^7.0.0",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.544.0",
    "markdown-it": "^14.1.0",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "nprogress": "^0.2.0",
    "openapi-types": "^12.1.3",
    "pinia": "^2.2.0",
    "playwright": "^1.55.1",
    "prettier": "^3.4.2",
    "prismjs": "^1.30.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.92.1",
    "stream-throttle": "^0.1.3",
    "typescript": "~5.6.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.5.25",
    "vue-i18n": "^10.0.8",
    "vue-markdown-render": "^2.3.0",
    "vue-router": "^4.4.2",
    "vue-tsc": "^2.1.10",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.1.0",
    "koa": "^3.0.1",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
