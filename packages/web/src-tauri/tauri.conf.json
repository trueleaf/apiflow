{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApiFlow",
  "version": "../package.json",
  "identifier": "cn.apiflow",
  "build": {
    "beforeDevCommand": "npm run dev:renderer:tauri",
    "devUrl": "http://localhost:4000",
    "beforeBuildCommand": "npm run build:renderer:tauri",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data: blob:; font-src 'self' data:; connect-src ipc: http: https: ws: wss: blob:; worker-src 'self' blob:; frame-src 'self' blob: data:; media-src 'self' blob: data: http: https:"
    }
  },
  "plugins": { "updater": { "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRUM5RkNBNUE5MkI5MTUKUldRVnVaSmF5cC9zWEl4VEJPTVNzVE9Oc0FJeXFrU29zK0ZXNmlFaHgyWktjN1ovNFVhMGIvME0K", "requireSignedVersion": true } },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "resources": { "../src/static/": "static/" },
    "shortDescription": "Visual API design and testing tool",
    "icon": ["../public/icons/256x256.png", "../public/icons/icon.ico", "../public/icons/icon.icns"],
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"] } },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
